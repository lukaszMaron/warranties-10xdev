---
import { type DraftField } from "../../lib/api";
import Button from "../../components/ui/Button.astro";
import Field from "../../components/ui/Field.astro";
import "../../styles/tokens.css";

const fields: { name: DraftField; label: string; type: string }[] = [
  { name: "product_name", label: "Nazwa produktu", type: "text" },
  { name: "purchase_date", label: "Data zakupu", type: "date" },
  { name: "seller", label: "Sprzedawca", type: "text" },
  { name: "payment_method", label: "Metoda płatności", type: "text" },
];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eaf1e9" />
    <title>Nowy zakup | PamiętajGwarancje</title>
  </head>
  <body>
    <main class="workspace">
      <header class="topbar">
        <a class="brand" href="/purchases/new" aria-label="PamiętajGwarancje, nowy zakup">
          <span class="brand-mark" aria-hidden="true">PG</span>
          <span>Pamiętaj<span class="brand-light">Gwarancje</span></span>
        </a>
        <span class="profile-label"><span class="profile-dot"></span> Mój profil</span>
      </header>

      <div class="page-heading">
        <p class="eyebrow">REJESTR ZAKUPÓW <span> / </span> DODAWANIE</p>
        <h1>Nowy zakup</h1>
        <p class="heading-copy">Wybierz ręczne wpisanie danych albo odczyt z dokumentu PDF.</p>
      </div>

      <div class="mode-switch" role="group" aria-label="Sposób dodania zakupu">
        <Button variant="mode" id="manual-mode" type="button" aria-pressed="false">Ręcznie</Button>
        <Button variant="mode" id="pdf-mode" type="button" aria-pressed="true">Z dokumentu PDF</Button>
      </div>

      <div class="entry-layout" id="entry-layout">
        <section class="upload-panel" id="upload-panel" aria-labelledby="upload-title">
          <div class="section-heading">
            <span class="step-number">01</span>
            <div>
              <h2 id="upload-title">Dokument zakupu</h2>
              <p>Wybierz plik PDF z paragonem lub fakturą.</p>
            </div>
          </div>

          <label class="file-drop" for="pdf-file" id="drop-target">
            <span class="document-icon" aria-hidden="true">
              <svg viewBox="0 0 32 36" fill="none">
                <path d="M5 2.5h14l8 8V32a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4.5a2 2 0 0 1 2-2Z" />
                <path d="M19 3v8h8M8 21h16M8 26h12" />
              </svg>
            </span>
            <span class="drop-title" id="file-name">Upuść PDF tutaj</span>
            <span class="drop-subtitle">lub wybierz z urządzenia</span>
            <span class="choose-file">Wybierz plik</span>
            <input id="pdf-file" type="file" accept="application/pdf,.pdf" />
          </label>
          <div class="upload-footnote">
            <span>PDF</span><span class="footnote-separator"></span><span>Maks. 20 MiB</span>
          </div>

          <Button variant="preview" id="preview-button" type="button" disabled>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M10 3v9m0 0 3.5-3.5M10 12 6.5 8.5M4 13.5v2A1.5 1.5 0 0 0 5.5 17h9a1.5 1.5 0 0 0 1.5-1.5v-2" />
            </svg>
            Odczytaj dokument
          </Button>
          <p class="privacy-note">
            <span class="privacy-mark" aria-hidden="true">●</span>
            Dokument jest analizowany lokalnie.
          </p>
          <p class="status-message" id="preview-message" role="status" aria-live="polite"></p>
        </section>

        <section class="details-panel" aria-labelledby="details-title">
          <div class="section-heading details-heading">
            <span class="step-number">02</span>
            <div>
              <h2 id="details-title">Sprawdź dane</h2>
              <p>Uzupełnij brakujące pola i popraw odczyt.</p>
            </div>
          </div>

          <form id="purchase-form" novalidate>
            <div class="field-grid">
              {fields.map(({ name, label, type }) => (
                <Field
                  label={label}
                  required={name === "product_name" || name === "purchase_date"}
                  warningFor={name}
                  class={name === "product_name" ? "field-wide" : ""}
                >
                  <input
                    data-draft-field={name}
                    name={name}
                    type={type}
                    required={name === "product_name" || name === "purchase_date"}
                    autocomplete={name === "seller" ? "organization" : "off"}
                  />
                </Field>
              ))}
              <Field label="Rodzaj zakupu" required>
                <select name="purchase_type" required data-draft-field="purchase_type">
                  <option value="">Wybierz rodzaj</option>
                  <option value="private">Prywatny</option>
                  <option value="business">Firmowy</option>
                </select>
              </Field>
              <Field label="Koniec gwarancji" optional>
                <input name="warranty_end_date" type="date" data-draft-field="warranty_end_date" />
              </Field>
            </div>
              <div class="form-rule"></div>
            <div class="form-actions">
              <p class="required-note"><b>*</b> Pole wymagane</p>
              <Button variant="save" id="save-button" type="submit" disabled>
                <span class="save-icon" aria-hidden="true">
                  <svg viewBox="0 0 20 20">
                    <path d="M10 3v8m0 0 3-3m-3 3L7 8m-3 5.5V16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-2.5" />
                  </svg>
                  <span class="save-spinner"></span>
                </span>
                Zapisz zakup
              </Button>
            </div>
          </form>
          <p class="status-message" id="save-message" role="status" aria-live="polite"></p>
          <section class="warranty-result" id="warranty-result" aria-live="polite" hidden>
            <div>
              <p class="result-eyebrow">WYNIK</p>
              <h3>Gwarancja</h3>
            </div>
            <p class="result-date" id="result-date"></p>
            <p class="result-basis" id="result-basis"></p>
            <p class="result-status" id="result-status"></p>
            <p class="result-warning" id="result-warning" role="alert" hidden></p>
            <p class="result-document" id="result-document"></p>
          </section>
        </section>
      </div>
      <footer class="page-footer"><span>Twoje zakupy pozostają w prywatnym profilu.</span></footer>
    </main>
  </body>
</html>

<script>
  import { previewPurchase, savePurchase } from "../../lib/api";

  const manualModeButton = document.querySelector<HTMLButtonElement>("#manual-mode");
  const pdfModeButton = document.querySelector<HTMLButtonElement>("#pdf-mode");
  const entryLayout = document.querySelector<HTMLElement>("#entry-layout");
  const uploadPanel = document.querySelector<HTMLElement>("#upload-panel");
  const fileInput = document.querySelector<HTMLInputElement>("#pdf-file");
  const dropTarget = document.querySelector<HTMLElement>("#drop-target");
  const fileName = document.querySelector<HTMLElement>("#file-name");
  const previewButton = document.querySelector<HTMLButtonElement>("#preview-button");
  const saveButton = document.querySelector<HTMLButtonElement>("#save-button");
  const previewMessage = document.querySelector<HTMLElement>("#preview-message");
  const saveMessage = document.querySelector<HTMLElement>("#save-message");
  const warrantyResult = document.querySelector<HTMLElement>("#warranty-result");
  const form = document.querySelector<HTMLFormElement>("#purchase-form");
  const editedFields = new Set<string>();
  let hasReceivedSuggestions = false;
  let selectedFile: File | undefined;
  let mode: "manual" | "pdf" = "pdf";
  let isPreviewing = false;
  let isSaving = false;

  function canSave() {
    const productName = form?.elements.namedItem("product_name");
    return Boolean(
      (mode === "manual" || fileInput?.files?.[0])
      && form?.checkValidity()
      && productName instanceof HTMLInputElement
      && productName.value.trim(),
    );
  }

  function updateSaveButton() {
    if (!saveButton) return;
    saveButton.disabled = isPreviewing || isSaving || !canSave();
    saveButton.classList.toggle("is-pending", isSaving);
    if (isSaving) saveButton.setAttribute("aria-busy", "true");
    else saveButton.removeAttribute("aria-busy");
  }

  function selectFile(file: File | undefined) {
    if (!fileInput || !fileName || !previewButton || !previewMessage) return;
    if (!file) {
      selectedFile = undefined;
      hasReceivedSuggestions = false;
      fileName.textContent = "Upuść PDF tutaj";
      previewButton.disabled = true;
      previewMessage.textContent = "";
      updateSaveButton();
      return;
    }
    if (selectedFile !== file) hasReceivedSuggestions = false;
    selectedFile = file;
    const transfer = new DataTransfer();
    transfer.items.add(file);
    fileInput.files = transfer.files;
    fileName.textContent = file.name;
    previewButton.disabled = false;
    previewMessage.textContent = "";
    updateSaveButton();
  }

  fileInput?.addEventListener("change", () => {
    selectFile(fileInput.files?.[0]);
  });

  function setMode(nextMode: "manual" | "pdf") {
    mode = nextMode;
    const isPdfMode = mode === "pdf";
    if (manualModeButton) manualModeButton.setAttribute("aria-pressed", String(!isPdfMode));
    if (pdfModeButton) pdfModeButton.setAttribute("aria-pressed", String(isPdfMode));
    if (uploadPanel) uploadPanel.hidden = !isPdfMode;
    entryLayout?.classList.toggle("is-manual", !isPdfMode);
    updateSaveButton();
  }

  manualModeButton?.addEventListener("click", () => setMode("manual"));
  pdfModeButton?.addEventListener("click", () => setMode("pdf"));

  for (const field of form?.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-draft-field]") ?? []) {
    const markEdited = () => {
      editedFields.add(field.name);
      updateSaveButton();
    };
    field.addEventListener("input", markEdited);
    field.addEventListener("change", markEdited);
  }

  dropTarget?.addEventListener("dragover", (event) => {
    event.preventDefault();
    dropTarget.classList.add("is-dragging");
  });
  dropTarget?.addEventListener("dragleave", () => dropTarget.classList.remove("is-dragging"));
  dropTarget?.addEventListener("drop", (event) => {
    event.preventDefault();
    dropTarget.classList.remove("is-dragging");
    selectFile((event as DragEvent).dataTransfer?.files[0]);
  });

  previewButton?.addEventListener("click", async () => {
    const file = fileInput?.files?.[0];
    if (mode !== "pdf" || !file || !previewButton || !previewMessage) return;
    previewButton.disabled = true;
    isPreviewing = true;
    updateSaveButton();
    previewButton.classList.add("is-pending");
    previewButton.setAttribute("aria-busy", "true");
    previewMessage.className = "status-message";
    previewMessage.textContent = "Odczytywanie dokumentu…";

    try {
      const draft = await previewPurchase(file);
      if (!hasReceivedSuggestions) {
        for (const name of ["product_name", "purchase_date", "seller", "payment_method"] as const) {
          const field = form?.elements.namedItem(name);
          if (field instanceof HTMLInputElement && !editedFields.has(name) && draft[name]) {
            field.value = draft[name];
          }
          const warning = document.querySelector<HTMLElement>(`[data-warning-for="${name}"]`);
          if (warning) warning.textContent = draft.warnings[name] ?? "";
        }
        hasReceivedSuggestions = true;
      }
      previewMessage.classList.add("is-success");
      previewMessage.textContent = "Odczyt zakończony. Sprawdź i popraw podpowiedzi.";
    } catch (error) {
      previewMessage.classList.add("is-error");
      previewMessage.textContent = error instanceof Error ? error.message : "Nie udało się odczytać dokumentu.";
    } finally {
      previewButton.disabled = false;
      isPreviewing = false;
      previewButton.classList.remove("is-pending");
      previewButton.removeAttribute("aria-busy");
      updateSaveButton();
    }
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const file = mode === "pdf" ? fileInput?.files?.[0] : undefined;
    if ((mode === "pdf" && !file) || !form || !saveMessage || !canSave() || isSaving) return;
    isSaving = true;
    updateSaveButton();
    if (warrantyResult) warrantyResult.hidden = true;
    saveMessage.className = "status-message";
    saveMessage.textContent = "Zapisywanie zakupu…";
    try {
      const saved = await savePurchase(form, file);
      const formatDate = (value: string) => new Intl.DateTimeFormat(undefined, {
        dateStyle: "long",
        timeZone: "UTC",
      }).format(new Date(`${value}T00:00:00Z`));
      const basisLabels = {
        user: "Data podana przez Ciebie",
        estimate: "Szacowana data końca gwarancji",
        unknown: "Nie ustalono daty końca gwarancji",
      } as const;
      const statusLabels = {
        active: "Aktywna",
        expired: "Wygasła",
        unknown: "Status nieznany",
      } as const;
      document.querySelector<HTMLElement>("#result-date")!.textContent = saved.effective_end_date
        ? `Koniec gwarancji: ${formatDate(saved.effective_end_date)}`
        : "Brak ustalonej daty końca gwarancji";
      document.querySelector<HTMLElement>("#result-basis")!.textContent = basisLabels[saved.date_basis];
      document.querySelector<HTMLElement>("#result-status")!.textContent = statusLabels[saved.status];
      const resultWarning = document.querySelector<HTMLElement>("#result-warning")!;
      const saveWarnings = Object.values(saved.warnings ?? {}).filter(Boolean);
      resultWarning.textContent = saveWarnings.join(" ");
      resultWarning.hidden = saveWarnings.length === 0;
      document.querySelector<HTMLElement>("#result-document")!.textContent = saved.document_ref
        ? "Dokument PDF zapisany w profilu."
        : "Zakup zapisany bez dokumentu.";
      if (warrantyResult) warrantyResult.hidden = false;
      saveMessage.className = "status-message is-success";
      saveMessage.textContent = `Zapisano zakup. Identyfikator: ${saved.purchase_id}`;
      form.reset();
      if (fileInput) fileInput.value = "";
      if (fileName) fileName.textContent = "Upuść PDF tutaj";
      selectedFile = undefined;
      hasReceivedSuggestions = false;
      editedFields.clear();
      if (previewButton) previewButton.disabled = true;
    } catch (error) {
      saveMessage.className = "status-message is-error";
      saveMessage.textContent = error instanceof Error ? error.message : "Nie udało się zapisać zakupu.";
    } finally {
      isSaving = false;
      updateSaveButton();
    }
  });

  updateSaveButton();
  for (const button of [manualModeButton, pdfModeButton]) {
    button?.addEventListener("click", () => {
      if (warrantyResult) warrantyResult.hidden = true;
      if (saveMessage) saveMessage.textContent = "";
    });
  }

  setMode("pdf");
</script>

<style>
  * { box-sizing: border-box; }
  body {
    margin: var(--space-body-margin);
    min-width: 320px;
    min-height: 100vh;
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    background-color: var(--color-background-page);
    background-image: repeating-linear-gradient(135deg, transparent 0 23px, var(--color-page-pattern) 23px 24px);
  }
  button, input, select { font: inherit; }
  .workspace { width: min(1120px, calc(100% - 64px)); margin: var(--space-workspace-margin); }
  .topbar { height: 76px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--color-topbar-divider); }
  .brand { display: inline-flex; align-items: center; gap: var(--space-brand-gap); color: var(--color-text-primary); text-decoration: none; font-size: 15px; font-weight: 700; }
  .brand-mark { display: grid; place-items: center; width: 34px; height: 34px; background: var(--color-action-primary); color: var(--color-on-action); border-radius: var(--radius-brand-mark); font-family: var(--font-serif); font-size: 13px; }
  .brand-light { font-weight: 400; }
  .profile-label { display: inline-flex; align-items: center; gap: var(--space-profile-label-gap); color: var(--color-profile-text); font-size: 13px; }
  .profile-dot { width: 8px; height: 8px; border-radius: var(--radius-round); background: var(--color-profile-indicator); box-shadow: 0 0 0 3px var(--color-profile-indicator-ring); }
  .page-heading { padding: var(--space-page-heading-padding); }
  .eyebrow { margin: var(--space-eyebrow-margin); color: var(--color-action-primary); font-size: 10px; font-weight: 700; letter-spacing: 1.2px; }
  .eyebrow span { color: var(--color-eyebrow-divider); padding: var(--space-eyebrow-divider-padding); }
  h1 { margin: var(--space-page-title-margin); font-family: var(--font-serif); font-size: 38px; line-height: 1.08; font-weight: 500; }
  .heading-copy { margin: var(--space-heading-copy-margin); color: var(--color-text-muted); font-size: 14px; }
  .mode-switch { display: inline-flex; margin: var(--space-mode-switch-margin); padding: var(--space-mode-switch-padding); border: 1px solid var(--color-mode-border); border-radius: var(--radius-mode-switch); background: var(--color-mode-surface); }
  .entry-layout { display: grid; grid-template-columns: minmax(280px, 0.82fr) minmax(390px, 1.18fr); background: var(--color-surface-page); border: 1px solid var(--color-panel-border); border-radius: var(--radius-panel); box-shadow: 0 12px 30px var(--color-panel-shadow); }
  .entry-layout.is-manual { grid-template-columns: minmax(0, 1fr); }
  .upload-panel[hidden] { display: none; }
  .upload-panel, .details-panel { padding: var(--space-entry-panel-padding); }
  .upload-panel { border-right: 1px solid var(--color-border-subtle); }
  .section-heading { display: flex; gap: var(--space-section-heading-gap); align-items: flex-start; margin-bottom: var(--space-section-heading-margin-bottom); }
  .step-number { display: grid; place-items: center; flex: 0 0 31px; height: 31px; border: 1px solid var(--color-step-border); border-radius: var(--radius-round); color: var(--color-action-primary); font-size: 10px; font-weight: 700; }
  h2 { margin: var(--space-section-title-margin); font-size: 17px; line-height: 1.2; font-weight: 650; }
  .section-heading p { margin: var(--space-section-copy-margin); color: var(--color-text-muted); font-size: 12px; line-height: 1.5; }
  .file-drop { display: flex; min-height: 224px; padding: var(--space-file-drop-padding); flex-direction: column; align-items: center; justify-content: center; border: 1px dashed var(--color-upload-border); border-radius: var(--radius-upload-target); background: var(--color-upload-surface); cursor: pointer; text-align: center; transition: background-color 160ms ease, border-color 160ms ease; }
  .file-drop:hover, .file-drop:focus-within, .file-drop.is-dragging { background: var(--color-upload-surface-hover); border-color: var(--color-action-primary); }
  .document-icon { display: grid; place-items: center; width: 47px; height: 50px; margin-bottom: var(--space-document-icon-margin-bottom); background: var(--color-document-icon-surface); border-radius: var(--radius-document-icon); }
  .document-icon svg { width: 27px; stroke: var(--color-action-primary); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .drop-title { max-width: 100%; overflow: hidden; color: var(--color-text-primary); font-size: 14px; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
  .drop-subtitle { margin-top: var(--space-drop-subtitle-margin-top); color: var(--color-text-muted); font-size: 12px; }
  .choose-file { margin-top: var(--space-choose-file-margin-top); padding: var(--space-choose-file-padding); border: 1px solid var(--color-file-action-border); border-radius: var(--radius-file-action); color: var(--color-action-primary); background: var(--color-surface-control); font-size: 12px; font-weight: 650; }
  .file-drop input { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; clip-path: inset(50%); }
  .upload-footnote { display: flex; gap: var(--space-upload-footnote-gap); align-items: center; margin: var(--space-upload-footnote-margin); color: var(--color-text-muted); font-size: 11px; }
  .upload-footnote span:first-child { color: var(--color-action-primary); font-weight: 700; }
  .footnote-separator { width: 3px; height: 3px; border-radius: var(--radius-round); background: var(--color-upload-separator); }
  .privacy-note { display: flex; align-items: center; gap: var(--space-privacy-note-gap); margin: var(--space-privacy-note-margin); color: var(--color-privacy-text); font-size: 11px; }
  .privacy-mark { color: var(--color-privacy-indicator); font-size: 9px; }
  .status-message { min-height: 18px; margin: var(--space-status-message-margin); color: var(--color-text-muted); font-size: 12px; line-height: 1.45; }
  .status-message.is-success { color: var(--color-action-primary); }
  .status-message.is-error { color: var(--color-feedback-error); }
  .warranty-result { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: var(--space-warranty-result-gap); margin-top: var(--space-warranty-result-margin-top); padding: var(--space-warranty-result-padding); border-left: 3px solid var(--color-action-primary); background: var(--color-result-surface); }
  .warranty-result[hidden] { display: none; }
  .result-eyebrow { margin: var(--space-result-eyebrow-margin); color: var(--color-action-primary); font-size: 9px; font-weight: 700; letter-spacing: 1px; }
  .warranty-result h3 { margin: var(--space-result-title-margin); font-size: 15px; }
  .result-date, .result-basis, .result-status, .result-document { margin: var(--space-result-copy-margin); color: var(--color-profile-text); font-size: 12px; line-height: 1.45; }
  .result-date { grid-column: 1; font-weight: 700; }
  .result-basis { grid-column: 1; }
  .result-status { grid-column: 2; grid-row: 1 / span 2; color: var(--color-action-primary); font-weight: 700; }
  .result-warning { grid-column: 1 / -1; margin: var(--space-result-copy-margin); color: var(--color-field-warning); font-size: 12px; line-height: 1.45; }
  .result-warning[hidden] { display: none; }
  .result-document { grid-column: 1 / -1; color: var(--color-text-muted); font-size: 11px; }
  .field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-field-grid-gap); }
  :global(.field-wide) { grid-column: 1 / -1; }
  .required-note b { color: var(--color-action-accent); font-weight: 700; }
  .form-rule { height: 1px; margin: var(--space-form-rule-margin); background: var(--color-border-subtle); }
  .required-note { margin: var(--space-required-note-margin); color: var(--color-required-note); font-size: 11px; }
  .form-actions { display: flex; align-items: center; justify-content: space-between; gap: var(--space-form-actions-gap); }
  .page-footer { display: flex; justify-content: space-between; padding: var(--space-page-footer-padding); color: var(--color-footer-text); font-size: 11px; }
  :global(:focus-visible) { outline: 3px solid var(--color-focus-visible); outline-offset: var(--space-focus-outline-offset); }

  @media (max-width: 760px) {
    .workspace { width: min(100% - 32px, 540px); }
    .topbar { height: 65px; }
    .page-heading { padding: var(--space-mobile-page-heading-padding); }
    h1 { font-size: 33px; }
    .entry-layout { grid-template-columns: 1fr; }
    .upload-panel, .details-panel { padding: var(--space-mobile-entry-panel-padding); }
    .upload-panel { border-right: 0; border-bottom: 1px solid var(--color-border-subtle); }
    .file-drop { min-height: 190px; }
  }
  @media (max-width: 420px) {
    .workspace { width: calc(100% - 24px); }
    .upload-panel, .details-panel { padding: var(--space-narrow-entry-panel-padding); }
    .field-grid { grid-template-columns: 1fr; }
    :global(.field-wide) { grid-column: auto; }
    .page-footer { gap: var(--space-narrow-page-footer-gap); font-size: 10px; }
