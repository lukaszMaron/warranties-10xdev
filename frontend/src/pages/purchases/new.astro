---
import { previewPurchase, type DraftField } from "../../lib/api";

const fields: { name: DraftField; label: string; type: string }[] = [
  { name: "product_name", label: "Nazwa produktu", type: "text" },
  { name: "purchase_date", label: "Data zakupu", type: "date" },
  { name: "seller", label: "Sprzedawca", type: "text" },
  { name: "payment_method", label: "Metoda płatności", type: "text" },
];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eaf1e9" />
    <title>Nowy zakup | PamiętajGwarancje</title>
  </head>
  <body>
    <main class="workspace">
      <header class="topbar">
        <a class="brand" href="/purchases/new" aria-label="PamiętajGwarancje, nowy zakup">
          <span class="brand-mark" aria-hidden="true">PG</span>
          <span>Pamiętaj<span class="brand-light">Gwarancje</span></span>
        </a>
        <span class="profile-label"><span class="profile-dot"></span> Mój profil</span>
      </header>

      <div class="page-heading">
        <p class="eyebrow">REJESTR ZAKUPÓW <span> / </span> DODAWANIE</p>
        <h1>Nowy zakup</h1>
        <p class="heading-copy">Dodaj paragon lub fakturę, a potem sprawdź odczytane dane.</p>
      </div>

      <div class="entry-layout">
        <section class="upload-panel" aria-labelledby="upload-title">
          <div class="section-heading">
            <span class="step-number">01</span>
            <div>
              <h2 id="upload-title">Dokument zakupu</h2>
              <p>Wybierz plik PDF z paragonem lub fakturą.</p>
            </div>
          </div>

          <label class="file-drop" for="pdf-file" id="drop-target">
            <span class="document-icon" aria-hidden="true">
              <svg viewBox="0 0 32 36" fill="none">
                <path d="M5 2.5h14l8 8V32a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4.5a2 2 0 0 1 2-2Z" />
                <path d="M19 3v8h8M8 21h16M8 26h12" />
              </svg>
            </span>
            <span class="drop-title" id="file-name">Upuść PDF tutaj</span>
            <span class="drop-subtitle">lub wybierz z urządzenia</span>
            <span class="choose-file">Wybierz plik</span>
            <input id="pdf-file" type="file" accept="application/pdf,.pdf" />
          </label>
          <div class="upload-footnote">
            <span>PDF</span><span class="footnote-separator"></span><span>Maks. 20 MiB</span>
          </div>

          <button class="preview-button" id="preview-button" type="button" disabled>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M10 3v9m0 0 3.5-3.5M10 12 6.5 8.5M4 13.5v2A1.5 1.5 0 0 0 5.5 17h9a1.5 1.5 0 0 0 1.5-1.5v-2" />
            </svg>
            Odczytaj dokument
          </button>
          <p class="privacy-note">
            <span class="privacy-mark" aria-hidden="true">●</span>
            Dokument jest analizowany lokalnie.
          </p>
          <p class="status-message" id="status-message" role="status" aria-live="polite"></p>
        </section>

        <section class="details-panel" aria-labelledby="details-title">
          <div class="section-heading details-heading">
            <span class="step-number">02</span>
            <div>
              <h2 id="details-title">Sprawdź dane</h2>
              <p>Uzupełnij brakujące pola i popraw odczyt.</p>
            </div>
          </div>

          <form id="purchase-form" novalidate>
            <div class="field-grid">
              {fields.map(({ name, label, type }) => (
                <label class={`field ${name === "product_name" ? "field-wide" : ""}`}>
                  <span>{label}{name === "product_name" || name === "purchase_date" ? <b> *</b> : null}</span>
                  <input
                    data-draft-field={name}
                    name={name}
                    type={type}
                    required={name === "product_name" || name === "purchase_date"}
                    autocomplete={name === "seller" ? "organization" : "off"}
                  />
                  <small class="field-warning" data-warning-for={name}></small>
                </label>
              ))}
              <label class="field">
                <span>Rodzaj zakupu<b> *</b></span>
                <select name="purchase_type" required data-draft-field="purchase_type">
                  <option value="">Wybierz rodzaj</option>
                  <option value="private">Prywatny</option>
                  <option value="business">Firmowy</option>
                </select>
              </label>
              <label class="field">
                <span>Koniec gwarancji <em>opcjonalnie</em></span>
                <input name="warranty_end_date" type="date" data-draft-field="warranty_end_date" />
              </label>
            </div>
            <div class="form-rule"></div>
            <div class="form-actions">
              <p class="required-note"><b>*</b> Pole wymagane</p>
              <button class="save-button" id="save-button" type="submit" disabled>
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M10 3v8m0 0 3-3m-3 3L7 8m-3 5.5V16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-2.5" />
                </svg>
                Zapisz zakup
              </button>
            </div>
          </form>
        </section>
      </div>
      <footer class="page-footer"><span>Twoje zakupy pozostają w prywatnym profilu.</span><span>01 / 02</span></footer>
    </main>
  </body>
</html>

<script>
  import { previewPurchase, savePurchase } from "../../lib/api";

  const fileInput = document.querySelector<HTMLInputElement>("#pdf-file");
  const dropTarget = document.querySelector<HTMLElement>("#drop-target");
  const fileName = document.querySelector<HTMLElement>("#file-name");
  const previewButton = document.querySelector<HTMLButtonElement>("#preview-button");
  const saveButton = document.querySelector<HTMLButtonElement>("#save-button");
  const statusMessage = document.querySelector<HTMLElement>("#status-message");
  const form = document.querySelector<HTMLFormElement>("#purchase-form");
  const editedFields = new Set<string>();
  let hasReceivedSuggestions = false;
  let selectedFile: File | undefined;
  let isPreviewing = false;
  let isSaving = false;

  function canSave() {
    const productName = form?.elements.namedItem("product_name");
    return Boolean(
      fileInput?.files?.[0]
      && form?.checkValidity()
      && productName instanceof HTMLInputElement
      && productName.value.trim(),
    );
  }

  function updateSaveButton() {
    if (saveButton) saveButton.disabled = isPreviewing || isSaving || !canSave();
  }

  function selectFile(file: File | undefined) {
    if (!file || !fileInput || !fileName || !previewButton || !statusMessage) return;
    if (selectedFile !== file) hasReceivedSuggestions = false;
    selectedFile = file;
    const transfer = new DataTransfer();
    transfer.items.add(file);
    fileInput.files = transfer.files;
    fileName.textContent = file.name;
    previewButton.disabled = false;
    statusMessage.textContent = "";
    updateSaveButton();
  }

  fileInput?.addEventListener("change", () => {
    selectFile(fileInput.files?.[0]);
  });

  for (const field of form?.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-draft-field]") ?? []) {
    const markEdited = () => {
      editedFields.add(field.name);
      updateSaveButton();
    };
    field.addEventListener("input", markEdited);
    field.addEventListener("change", markEdited);
  }

  dropTarget?.addEventListener("dragover", (event) => {
    event.preventDefault();
    dropTarget.classList.add("is-dragging");
  });
  dropTarget?.addEventListener("dragleave", () => dropTarget.classList.remove("is-dragging"));
  dropTarget?.addEventListener("drop", (event) => {
    event.preventDefault();
    dropTarget.classList.remove("is-dragging");
    selectFile((event as DragEvent).dataTransfer?.files[0]);
  });

  previewButton?.addEventListener("click", async () => {
    const file = fileInput?.files?.[0];
    if (!file || !previewButton || !statusMessage) return;
    previewButton.disabled = true;
    isPreviewing = true;
    updateSaveButton();
    previewButton.classList.add("is-pending");
    previewButton.setAttribute("aria-busy", "true");
    statusMessage.className = "status-message";
    statusMessage.textContent = "Odczytywanie dokumentu…";

    try {
      const draft = await previewPurchase(file);
      if (!hasReceivedSuggestions) {
        for (const name of ["product_name", "purchase_date", "seller", "payment_method"] as const) {
          const field = form?.elements.namedItem(name);
          if (field instanceof HTMLInputElement && !editedFields.has(name) && draft[name]) {
            field.value = draft[name];
          }
          const warning = document.querySelector<HTMLElement>(`[data-warning-for="${name}"]`);
          if (warning) warning.textContent = draft.warnings[name] ?? "";
        }
        hasReceivedSuggestions = true;
      }
      statusMessage.classList.add("is-success");
      statusMessage.textContent = "Odczyt zakończony. Sprawdź i popraw podpowiedzi.";
    } catch (error) {
      statusMessage.classList.add("is-error");
      statusMessage.textContent = error instanceof Error ? error.message : "Nie udało się odczytać dokumentu.";
    } finally {
      previewButton.disabled = false;
      isPreviewing = false;
      previewButton.classList.remove("is-pending");
      previewButton.removeAttribute("aria-busy");
      updateSaveButton();
    }
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const file = fileInput?.files?.[0];
    if (!file || !form || !statusMessage || !canSave() || isSaving) return;
    isSaving = true;
    updateSaveButton();
    statusMessage.className = "status-message";
    statusMessage.textContent = "Zapisywanie zakupu…";
    try {
      const saved = await savePurchase(file, form);
      statusMessage.classList.add("is-success");
      statusMessage.textContent = `Zapisano zakup. Identyfikator: ${saved.purchase_id}`;
      form.reset();
      fileInput.value = "";
      fileName!.textContent = "Upuść PDF tutaj";
      selectedFile = undefined;
      hasReceivedSuggestions = false;
      editedFields.clear();
      previewButton!.disabled = true;
    } catch (error) {
      statusMessage.classList.add("is-error");
      statusMessage.textContent = error instanceof Error ? error.message : "Nie udało się zapisać zakupu.";
    } finally {
      isSaving = false;
      updateSaveButton();
    }
  });

  updateSaveButton();
</script>

<style>
  :root {
    color-scheme: light;
    --ink: #1d302a;
    --muted: #687970;
    --line: #d6e1d7;
    --paper: #fbfdf8;
    --forest: #1c5947;
    --forest-dark: #154536;
    --coral: #cb5f49;
    --wash: #eaf1e9;
    --sans: "Aptos", "Trebuchet MS", sans-serif;
    --serif: "Palatino Linotype", "Book Antiqua", Georgia, serif;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-width: 320px;
    min-height: 100vh;
    color: var(--ink);
    font-family: var(--sans);
    background-color: var(--wash);
    background-image: repeating-linear-gradient(135deg, transparent 0 23px, rgb(28 89 71 / 3%) 23px 24px);
  }
  button, input, select { font: inherit; }
  .workspace { width: min(1120px, calc(100% - 64px)); margin: 0 auto; }
  .topbar { height: 76px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgb(29 48 42 / 18%); }
  .brand { display: inline-flex; align-items: center; gap: 11px; color: var(--ink); text-decoration: none; font-size: 15px; font-weight: 700; }
  .brand-mark { display: grid; place-items: center; width: 34px; height: 34px; background: var(--forest); color: white; border-radius: 7px 7px 7px 2px; font-family: var(--serif); font-size: 13px; }
  .brand-light { font-weight: 400; }
  .profile-label { display: inline-flex; align-items: center; gap: 9px; color: #43584f; font-size: 13px; }
  .profile-dot { width: 8px; height: 8px; border-radius: 50%; background: #62a681; box-shadow: 0 0 0 3px rgb(98 166 129 / 15%); }
  .page-heading { padding: 42px 0 28px; }
  .eyebrow { margin: 0 0 10px; color: var(--forest); font-size: 10px; font-weight: 700; letter-spacing: 1.2px; }
  .eyebrow span { color: #99a99e; padding: 0 7px; }
  h1 { margin: 0; font-family: var(--serif); font-size: 38px; line-height: 1.08; font-weight: 500; }
  .heading-copy { margin: 9px 0 0; color: var(--muted); font-size: 14px; }
  .entry-layout { display: grid; grid-template-columns: minmax(280px, 0.82fr) minmax(390px, 1.18fr); background: var(--paper); border: 1px solid #d8e2d8; border-radius: 8px; box-shadow: 0 12px 30px rgb(35 62 49 / 7%); }
  .upload-panel, .details-panel { padding: 30px; }
  .upload-panel { border-right: 1px solid var(--line); }
  .section-heading { display: flex; gap: 13px; align-items: flex-start; margin-bottom: 24px; }
  .step-number { display: grid; place-items: center; flex: 0 0 31px; height: 31px; border: 1px solid #b8cbbd; border-radius: 50%; color: var(--forest); font-size: 10px; font-weight: 700; }
  h2 { margin: 2px 0 4px; font-size: 17px; line-height: 1.2; font-weight: 650; }
  .section-heading p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.5; }
  .file-drop { display: flex; min-height: 224px; padding: 22px 16px; flex-direction: column; align-items: center; justify-content: center; border: 1px dashed #9db8a5; border-radius: 6px; background: #f4f8f2; cursor: pointer; text-align: center; transition: background-color 160ms ease, border-color 160ms ease; }
  .file-drop:hover, .file-drop:focus-within, .file-drop.is-dragging { background: #edf5ec; border-color: var(--forest); }
  .document-icon { display: grid; place-items: center; width: 47px; height: 50px; margin-bottom: 13px; background: #dcebe0; border-radius: 7px; }
  .document-icon svg { width: 27px; stroke: var(--forest); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .drop-title { max-width: 100%; overflow: hidden; color: var(--ink); font-size: 14px; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
  .drop-subtitle { margin-top: 4px; color: var(--muted); font-size: 12px; }
  .choose-file { margin-top: 14px; padding: 8px 14px; border: 1px solid #a9c2ae; border-radius: 5px; color: var(--forest); background: white; font-size: 12px; font-weight: 650; }
  .file-drop input { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; clip-path: inset(50%); }
  .upload-footnote { display: flex; gap: 9px; align-items: center; margin: 10px 0 21px; color: var(--muted); font-size: 11px; }
  .upload-footnote span:first-child { color: var(--forest); font-weight: 700; }
  .footnote-separator { width: 3px; height: 3px; border-radius: 50%; background: #91a59a; }
  .preview-button { display: flex; width: 100%; min-height: 44px; align-items: center; justify-content: center; gap: 9px; border: 0; border-radius: 5px; background: var(--forest); color: white; cursor: pointer; font-size: 13px; font-weight: 700; transition: background-color 140ms ease, transform 140ms ease; }
  .preview-button:hover:not(:disabled) { background: var(--forest-dark); transform: translateY(-1px); }
  .preview-button:disabled { background: #aab9af; cursor: not-allowed; }
  .preview-button.is-pending { background: #687f71; }
  .preview-button svg { width: 18px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .privacy-note { display: flex; align-items: center; gap: 7px; margin: 15px 0 0; color: #5d7668; font-size: 11px; }
  .privacy-mark { color: #68a57d; font-size: 9px; }
  .status-message { min-height: 18px; margin: 12px 0 0; color: var(--muted); font-size: 12px; line-height: 1.45; }
  .status-message.is-success { color: var(--forest); }
  .status-message.is-error { color: #a53f35; }
  .field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 17px 15px; }
  .field { display: flex; min-width: 0; flex-direction: column; gap: 7px; color: #40564b; font-size: 12px; font-weight: 650; }
  .field-wide { grid-column: 1 / -1; }
  .field b, .required-note b { color: var(--coral); font-weight: 700; }
  .field em { margin-left: 4px; color: #84948b; font-size: 10px; font-style: normal; font-weight: 400; }
  .field input, .field select { width: 100%; height: 42px; padding: 0 11px; border: 1px solid #ccd8ce; border-radius: 4px; outline: none; background: white; color: var(--ink); font-size: 13px; font-weight: 400; }
  .field input:focus, .field select:focus { border-color: var(--forest); box-shadow: 0 0 0 3px rgb(28 89 71 / 12%); }
  .field select:invalid { color: #84948b; }
  .field-warning { min-height: 0; color: #9c5b33; font-size: 10px; line-height: 1.35; font-weight: 400; }
  .form-rule { height: 1px; margin: 23px 0 12px; background: var(--line); }
  .required-note { margin: 0; color: #7b8b81; font-size: 11px; }
  .form-actions { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
  .save-button { display: inline-flex; min-height: 42px; align-items: center; justify-content: center; gap: 8px; padding: 0 15px; border: 0; border-radius: 5px; background: var(--coral); color: white; cursor: pointer; font-size: 12px; font-weight: 700; }
  .save-button:hover:not(:disabled) { background: #b94e3a; }
  .save-button:disabled { background: #c3c9c2; cursor: not-allowed; }
  .save-button svg { width: 17px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .page-footer { display: flex; justify-content: space-between; padding: 21px 1px 30px; color: #708078; font-size: 11px; }
  .page-footer span:last-child { color: var(--forest); font-weight: 700; }
  :focus-visible { outline: 3px solid rgb(203 95 73 / 60%); outline-offset: 3px; }

  @media (max-width: 760px) {
    .workspace { width: min(100% - 32px, 540px); }
    .topbar { height: 65px; }
    .page-heading { padding: 31px 0 23px; }
    h1 { font-size: 33px; }
    .entry-layout { grid-template-columns: 1fr; }
    .upload-panel, .details-panel { padding: 24px 21px; }
    .upload-panel { border-right: 0; border-bottom: 1px solid var(--line); }
    .file-drop { min-height: 190px; }
  }
  @media (max-width: 420px) {
    .workspace { width: calc(100% - 24px); }
    .upload-panel, .details-panel { padding: 21px 16px; }
    .field-grid { grid-template-columns: 1fr; }
    .field-wide { grid-column: auto; }
    .page-footer { gap: 15px; font-size: 10px; }
  }
</style>